{
  "name": "A_cifar10_fedavg_dir0.1_s2",
  "seed": 2,
  "dataset": "cifar10",
  "mode": "federated",
  "num_clients": 15,
  "rounds": 60,
  "local_epochs": 2,
  "lr": 0.01,
  "checkpoint_every": 5,
  "subsample": 20000,
  "subsample_test": 5000,
  "strategy": "fedavg",
  "model": {
    "backend": "torch_cnn",
    "width": 32,
    "batch_size": 64,
    "in_channels": 3,
    "img_size": 32
  },
  "strategy_params": {
    "mu": 0.01,
    "moon_mu": 1.0,
    "moon_tau": 0.5
  },
  "partition": {
    "kind": "dirichlet",
    "alpha": 0.1,
    "num_clients": 15
  }
}